# Copy to .env. Nothing here is committed.
TZ=America/Indiana/Indianapolis
PUID=1000
PGID=1000

# Amcrest IP8M-T2599EW on the IoT VLAN, static lease, no WAN egress.
CAM_IP=10.20.0.50
CAM_USER=frigate           # make a dedicated read-only camera user, not admin
CAM_PASS=change-me

# Where Frigate keeps clips/recordings. Point at real storage, not the boot disk.
FRIGATE_MEDIA=/srv/yardwatch/frigate

# Intel iGPU groups on the host: ls -ln /dev/dri  (render is usually 107, video 44)
RENDER_GID=107
VIDEO_GID=44

# Image pins
FRIGATE_TAG=stable
BIRDNET_TAG=20260823
FUGLERAMME_TAG=latest
YAWAMF_TAG=latest-intel    # latest-cpu if no iGPU, latest-cuda for NVIDIA
